      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(docker push *)",
      "Bash(kubectl apply *)",
      "WebFetch"
    ]
  },
  "enabledMcpjsonServers": [],
  "disableClaudeAiConnectors": true
}
